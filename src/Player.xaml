<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ya Mini Player"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Ellipse x:Name="bg" Fill="White" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.14"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bg" Property="Opacity" Value="0.28"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Secondary buttons stay dimmed until the pointer is over the player -->
    <Style x:Key="HoverBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Margin="12" Background="Transparent">
    <Border CornerRadius="14" Background="#FF161618">
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
      </Border.Effect>
    </Border>
    <Border x:Name="Card" CornerRadius="14" Background="#FF161618" BorderBrush="#26FFFFFF" BorderThickness="1">
      <Grid x:Name="ClipGrid">
        <Rectangle x:Name="Backdrop" Opacity="0.32">
          <Rectangle.Effect>
            <BlurEffect Radius="30"/>
          </Rectangle.Effect>
        </Rectangle>

        <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Volume bar: click or drag; the fill height is set from code -->
        <Grid x:Name="VolBar" Width="18" Margin="6,8,-6,8" Background="Transparent" Cursor="Hand">
          <!-- Two star rows split the bar at the current level without giving it a fixed height -->
          <Grid.RowDefinitions>
            <RowDefinition x:Name="VolEmpty" Height="*"/>
            <RowDefinition x:Name="VolFull" Height="0"/>
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="2" Width="4" CornerRadius="2" Background="#33FFFFFF" HorizontalAlignment="Center"/>
          <Border Grid.Row="1" Width="4" CornerRadius="2" Background="#E6FFFFFF" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Column="1">
        <!-- Normal view -->
        <Grid x:Name="NormalView" Width="300" Height="92">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="Art" Width="72" Height="72" Margin="10,0,0,0" CornerRadius="9" Background="#FF2A2A2E" VerticalAlignment="Center">
            <TextBlock x:Name="ArtNote" Text="&#x266A;" FontSize="30" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Grid Grid.Column="1" Margin="12,10,10,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Text lines are filled in by code; long ones scroll instead of being cut off -->
            <Canvas x:Name="TitleHost" Height="19" ClipToBounds="True" Background="Transparent"/>
            <Canvas x:Name="ArtistHost" Grid.Row="1" Height="16" Margin="0,1,0,0" ClipToBounds="True" Background="Transparent"/>
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal" Margin="-6,0,0,0">
                <Button x:Name="PrevBtn" Style="{StaticResource Btn}" ToolTip="Previous">
                  <Path Fill="White" Data="M13,1 L5,7 L13,13 Z M1,1 H4 V13 H1 Z"/>
                </Button>
                <Button x:Name="PlayBtn" Style="{StaticResource Btn}" Width="32" Height="32" Margin="4,0" ToolTip="Play / Pause">
                  <Path x:Name="PlayIcon" Fill="White" Data="M3,1 L13,7 L3,13 Z"/>
                </Button>
                <Button x:Name="NextBtn" Style="{StaticResource Btn}" ToolTip="Next">
                  <Path Fill="White" Data="M1,1 L9,7 L1,13 Z M10,1 H13 V13 H10 Z"/>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="PinBtn" Style="{StaticResource HoverBtn}">
                  <Path x:Name="PinIcon" StrokeThickness="1.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                        Data="M3,1 H9 V2 H8 V6 L10,8 V9 H6.5 V13 H5.5 V9 H2 V8 L4,6 V2 H3 Z"/>
                </Button>
                <Button x:Name="CompactBtn" Style="{StaticResource HoverBtn}" ToolTip="Compact mode">
                  <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,1 L5,5 L9,1 M1,6 L5,10 L9,6"/>
                </Button>
                <Button x:Name="CloseBtn" Style="{StaticResource HoverBtn}" ToolTip="Close">
                  <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,1 L9,9 M9,1 L1,9"/>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>

        <!-- Compact view -->
        <Grid x:Name="CompactView" Width="300" Height="44" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="ArtC" Width="32" Height="32" Margin="6,0,0,0" CornerRadius="6" Background="#FF2A2A2E" VerticalAlignment="Center">
            <TextBlock x:Name="ArtNoteC" Text="&#x266A;" FontSize="15" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Canvas x:Name="LineHost" Grid.Column="1" Margin="9,0,4,1" Height="18" VerticalAlignment="Center" ClipToBounds="True" Background="Transparent"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
            <Button x:Name="PrevBtnC" Style="{StaticResource Btn}" Width="24" Height="24" ToolTip="Previous">
              <Path Fill="White" Data="M11,1 L4.5,6 L11,11 Z M1,1 H3.5 V11 H1 Z"/>
            </Button>
            <Button x:Name="PlayBtnC" Style="{StaticResource Btn}" Width="26" Height="26" ToolTip="Play / Pause">
              <Path x:Name="PlayIconC" Fill="White" Data="M3,1 L13,7 L3,13 Z" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <Button x:Name="NextBtnC" Style="{StaticResource Btn}" Width="24" Height="24" ToolTip="Next">
              <Path Fill="White" Data="M1,1 L7.5,6 L1,11 Z M8.5,1 H11 V11 H8.5 Z"/>
            </Button>
            <Button x:Name="PinBtnC" Style="{StaticResource HoverBtn}" Margin="6,0,0,0">
              <Path x:Name="PinIconC" StrokeThickness="1.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                    Data="M3,1 H9 V2 H8 V6 L10,8 V9 H6.5 V13 H5.5 V9 H2 V8 L4,6 V2 H3 Z"/>
            </Button>
            <Button x:Name="ExpandBtn" Style="{StaticResource HoverBtn}" ToolTip="Vinyl mode">
              <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,5 L5,1 L9,5 M1,10 L5,6 L9,10"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Vinyl view: a record that spins while music plays -->
        <Grid x:Name="VinylView" Width="230" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Width="190" Height="190" Margin="0,16,0,0" HorizontalAlignment="Center">
            <Grid x:Name="Disc" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <RotateTransform/>
              </Grid.RenderTransform>
              <Ellipse Fill="#FF0A0A0B" Stroke="#40FFFFFF" StrokeThickness="1"/>
              <Ellipse Margin="7" Stroke="#16FFFFFF" StrokeThickness="1"/>
              <Ellipse Margin="13" Stroke="#10FFFFFF" StrokeThickness="1"/>
              <Ellipse Margin="19" Stroke="#16FFFFFF" StrokeThickness="1"/>
              <Ellipse Margin="25" Stroke="#10FFFFFF" StrokeThickness="1"/>
              <Ellipse Margin="31" Stroke="#16FFFFFF" StrokeThickness="1"/>
              <Ellipse x:Name="DiscArt" Width="116" Height="116" Fill="#FF2A2A2E" Stroke="#30FFFFFF" StrokeThickness="1"/>
              <TextBlock x:Name="ArtNoteV" Text="&#x266A;" FontSize="34" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,22"/>
              <Ellipse Width="12" Height="12" Fill="#FF161618" Stroke="#50FFFFFF" StrokeThickness="1"/>
            </Grid>
            <!-- Fixed highlight, so the record looks lit from one side as it turns -->
            <Ellipse IsHitTestVisible="False">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#00FFFFFF" Offset="0.20"/>
                  <GradientStop Color="#26FFFFFF" Offset="0.35"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.50"/>
                  <GradientStop Color="#1AFFFFFF" Offset="0.68"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.82"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <Canvas x:Name="TitleHostV" Grid.Row="1" Height="19" Margin="16,12,16,0" ClipToBounds="True" Background="Transparent"/>
          <Canvas x:Name="ArtistHostV" Grid.Row="2" Height="16" Margin="16,1,16,0" ClipToBounds="True" Background="Transparent"/>
          <Grid Grid.Row="3" Margin="10,8,10,10">
            <Button x:Name="PinBtnV" Style="{StaticResource HoverBtn}" HorizontalAlignment="Left">
              <Path x:Name="PinIconV" StrokeThickness="1.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                    Data="M3,1 H9 V2 H8 V6 L10,8 V9 H6.5 V13 H5.5 V9 H2 V8 L4,6 V2 H3 Z"/>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PrevBtnV" Style="{StaticResource Btn}" ToolTip="Previous">
                <Path Fill="White" Data="M13,1 L5,7 L13,13 Z M1,1 H4 V13 H1 Z"/>
              </Button>
              <Button x:Name="PlayBtnV" Style="{StaticResource Btn}" Width="32" Height="32" Margin="4,0" ToolTip="Play / Pause">
                <Path x:Name="PlayIconV" Fill="White" Data="M3,1 L13,7 L3,13 Z"/>
              </Button>
              <Button x:Name="NextBtnV" Style="{StaticResource Btn}" ToolTip="Next">
                <Path Fill="White" Data="M1,1 L9,7 L1,13 Z M10,1 H13 V13 H10 Z"/>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="ModeBtnV" Style="{StaticResource HoverBtn}" ToolTip="Lyrics">
                <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,2 H9 M1,5.5 H9 M1,9 H6"/>
              </Button>
              <Button x:Name="CloseBtnV" Style="{StaticResource HoverBtn}" ToolTip="Close">
                <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,1 L9,9 M9,1 L1,9"/>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Lyrics view: the words of the current track, following along when they are timed -->
        <Grid x:Name="LyricsView" Width="300" Height="340" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ArtL" Width="40" Height="40" CornerRadius="7" Background="#FF2A2A2E">
              <TextBlock x:Name="ArtNoteL" Text="&#x266A;" FontSize="18" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <Canvas x:Name="TitleHostL" Height="18" ClipToBounds="True" Background="Transparent"/>
              <Canvas x:Name="ArtistHostL" Height="16" ClipToBounds="True" Background="Transparent"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="16,8,16,0">
            <ScrollViewer x:Name="LyricScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <!-- Lines fade out towards the top and bottom edges -->
              <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="Transparent" Offset="0"/>
                  <GradientStop Color="Black" Offset="0.12"/>
                  <GradientStop Color="Black" Offset="0.88"/>
                  <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
              </ScrollViewer.OpacityMask>
              <StackPanel x:Name="LyricPanel"/>
            </ScrollViewer>
            <TextBlock x:Name="LyricStatus" FontSize="13" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <Grid Grid.Row="2" Margin="10,6,10,10">
            <Button x:Name="PinBtnL" Style="{StaticResource HoverBtn}" HorizontalAlignment="Left">
              <Path x:Name="PinIconL" StrokeThickness="1.2" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                    Data="M3,1 H9 V2 H8 V6 L10,8 V9 H6.5 V13 H5.5 V9 H2 V8 L4,6 V2 H3 Z"/>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="PrevBtnL" Style="{StaticResource Btn}" ToolTip="Previous">
                <Path Fill="White" Data="M13,1 L5,7 L13,13 Z M1,1 H4 V13 H1 Z"/>
              </Button>
              <Button x:Name="PlayBtnL" Style="{StaticResource Btn}" Width="32" Height="32" Margin="4,0" ToolTip="Play / Pause">
                <Path x:Name="PlayIconL" Fill="White" Data="M3,1 L13,7 L3,13 Z"/>
              </Button>
              <Button x:Name="NextBtnL" Style="{StaticResource Btn}" ToolTip="Next">
                <Path Fill="White" Data="M1,1 L9,7 L1,13 Z M10,1 H13 V13 H10 Z"/>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="ModeBtnL" Style="{StaticResource HoverBtn}" ToolTip="Full size">
                <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,1 L5,5 L9,1 M1,6 L5,10 L9,6"/>
              </Button>
              <Button x:Name="CloseBtnL" Style="{StaticResource HoverBtn}" ToolTip="Close">
                <Path Stroke="#CCFFFFFF" StrokeThickness="1.5" Data="M1,1 L9,9 M9,1 L1,9"/>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
        </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
